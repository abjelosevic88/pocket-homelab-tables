[Unit]
Description=Pocket Tables — your own small databases
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-tables
Group=pocket-tables
ExecStart=/usr/local/bin/pocket-tables
Environment=DATA_DIR=/var/lib/pocket-tables
Environment=PORT=8080
Environment=BASE_URL=https://tables.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-tables
PrivateTmp=true

[Install]
WantedBy=multi-user.target
